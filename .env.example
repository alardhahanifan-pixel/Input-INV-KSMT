# Konfigurasi Environment untuk Aplikasi Input Penjualan
# Copy file ini menjadi .env dan sesuaikan nilai-nilainya

# Environment (development/production)
FLASK_ENV=development

# Kunci rahasia untuk session (ubah di production!)
SECRET_KEY=your-secret-key-here

# URL Database (default: SQLite)
DATABASE_URL=sqlite:///penjualan.db

# Konfigurasi Server
HOST=0.0.0.0
PORT=8080
DEBUG=True